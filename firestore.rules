rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isViewer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyRole == 'viewer';
    }

    function hasValidNewProfile() {
      return request.resource.data.keys().hasOnly([
          'name', 'email', 'company', 'workRole', 'role', 'plan', 'trialEndsAt', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'role', 'plan', 'trialEndsAt', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'pilot-partner'
        && request.resource.data.plan == 'trial'
        && request.resource.data.trialEndsAt is timestamp
        && request.resource.data.trialEndsAt > request.time - duration.value(5, 'm')
        && request.resource.data.trialEndsAt <= request.time + duration.value(14, 'd') + duration.value(5, 'm')
        && request.resource.data.createdAt == request.time
        && (!('company' in request.resource.data)
          || (request.resource.data.company is string && request.resource.data.company.size() <= 160))
        && (!('workRole' in request.resource.data)
          || request.resource.data.workRole in [
            'Farm owner', 'Equipment operator', 'Operations manager', 'Enterprise lead'
          ]);
    }

    // Clients can create a basic trial profile but cannot grant themselves a paid plan or role.
    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId) && hasValidNewProfile();
      allow update: if ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'company', 'workRole'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && (!('company' in request.resource.data)
          || (request.resource.data.company is string && request.resource.data.company.size() <= 160))
        && (!('workRole' in request.resource.data)
          || request.resource.data.workRole in [
            'Farm owner', 'Equipment operator', 'Operations manager', 'Enterprise lead'
          ]);
      allow delete: if false;
    }

    // Energy readings, fault readings, reports, inspections — every
    // document is scoped to the uid that created it. No cross-user reads.
    match /energy_readings/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid && !isViewer();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && !isViewer();
    }

    match /fault_readings/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid && !isViewer();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && !isViewer();
    }

    match /reports/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      // Reports are created server-side only (via Firebase Admin in the API route).
      allow create, update, delete: if false;
    }

    match /inspections/{docId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Marketplace waitlist — write-only from the server (Admin SDK), never
    // readable by clients (contains lead emails).
    match /marketplace_waitlist/{docId} {
      allow read, write: if false;
    }

    match /companies/{companyId}/{document=**} {
      allow read, write: if false;
    }

    match /company_invitations/{invitationId} {
      allow read, write: if false;
    }

    match /company_invitation_index/{indexId} {
      allow read, write: if false;
    }

    match /flutterwave_checkouts/{checkoutId} {
      allow read, write: if false;
    }

    match /flutterwave_subscriptions/{subscriptionId} {
      allow read, write: if false;
    }
  }
}
