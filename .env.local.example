# ============================================================
# BRIEF GROUP — ENVIRONMENT VARIABLES
# Copy this file to .env.local for local dev, and add the same
# keys in Vercel → Project → Settings → Environment Variables
# ============================================================

# --- Firebase (client SDK — safe to expose, these are public config) ---
# Get these from Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-only — NEVER expose these with NEXT_PUBLIC_) ---
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Anthropic (Claude) — powers the AI assistant + automated report writer ---
# Add this last, per your note — everything else works without it,
# these two features return a clear "not configured" error until it's set.
ANTHROPIC_API_KEY=

# --- Weather (Farm Prediction module) ---
# Open-Meteo requires no API key (used by default).
# If you'd rather use a keyed provider (e.g. OpenWeatherMap), set this and
# flip WEATHER_PROVIDER below.
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=

# --- Rate limiting (Upstash Redis) — recommended before sharing the pilot link publicly ---
# Protects your Anthropic spend: without this, nothing stops repeated hits to
# /api/chat, /api/reports/generate, /api/vision/analyze. Free tier at upstash.com
# (Redis → REST API), no credit card required. Leave blank and requests are
# simply uncapped — nothing breaks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Transactional email (Resend) — welcome email on signup, waitlist confirmation ---
# Free tier: 3,000 emails/month, no credit card required. Get a key at resend.com.
# Until you verify your own domain (briefgroup.net) in Resend, sending is limited
# to your own verified email address — fine for testing, verify the domain before
# your first real pilot signups.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Brief Group <onboarding@resend.dev>
