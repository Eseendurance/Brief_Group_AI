# ============================================================
# BRIEF GROUP — ENVIRONMENT VARIABLES
# Copy this file to .env.local for local dev, and add the same
# keys in Vercel → Project → Settings → Environment Variables
# ============================================================

# --- Firebase (client SDK — safe to expose, these are public config) ---
# Get these from Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id
FIREBASE_MEASUREMENT_ID=your_google_analytics_measurement_id
SITE_BASE=https://briefgroup.net

# --- Firebase Admin (server-only — NEVER expose these with NEXT_PUBLIC_) ---
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_ADMIN_CLIENT_EMAIL=your_firebase_admin_client_email
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_ID=your_google_service_client_id
FIREBASE_ADMIN_PRIVATE_KEY=replace_with_service_account_private_key
FIREBASE_ADMIN_PRIVATE_KEY_ID=your_service_account_key_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/YOUR_ADMIN_CLIENT_EMAIL
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
FIREBASE_WEB_PUSH_CERTIFICATE_KEY=your_public_vapid_key

# --- Anthropic (Claude) — powers the AI assistant + automated report writer ---
# Add this last, per your note — everything else works without it,
# these two features return a clear "not configured" error until it's set.
ANTHROPIC_API_KEY=

# --- Weather (Farm Prediction module) ---
# Open-Meteo requires no API key (used by default).
# If you'd rather use a keyed provider (e.g. OpenWeatherMap), set this and
# flip WEATHER_PROVIDER below.
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=replace_with_openweather_api_key


# --- Rate limiting (Upstash Redis) — required in production ---
# Protects AI, contact, and waitlist endpoints. Production requests fail closed
# if these values are missing. Local development remains usable without Redis.
# Create a Redis REST database at upstash.com and set both values below.
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token


# --- Transactional email (Resend) — welcome email on signup, waitlist confirmation ---
# Free tier: 3,000 emails/month, no credit card required. Get a key at resend.com.
# Until you verify your own domain (briefgroup.net) in Resend, sending is limited
# to your own verified email address — fine for testing, verify the domain before
# your first real pilot signups.
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=Brief Group <onboarding@resend.dev>
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace_with_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_PRICE_STARTER=replace_with_stripe_starter_price_id
STRIPE_PRICE_GROWTH=replace_with_stripe_growth_price_id
PAYSTACK_SECRET_KEY=replace_with_paystack_secret_key
